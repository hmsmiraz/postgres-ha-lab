#!/usr/bin/env bash
set -euo pipefail
gitleaks git --pre-commit --staged --redact --verbose

# Block identifiers that must not appear in this public repository.
# The names are assembled from pieces so that this file does not contain them.
pat="$(printf '%s%s' clou dly)|$(printf '%s%s' rev ora)"
hits=$(git diff --cached --no-color -U0 | grep -E '^\+' | grep -ciE "$pat" || true)
if [ "$hits" -gt 0 ]; then
  echo "BLOCKED: $hits staged line(s) contain an identifier that must not be published. Files:" >&2
  git diff --cached --name-only -z | xargs -0 -r grep -IliE "$pat" 2>/dev/null | sed 's/^/  /' >&2 || true
  exit 1
fi
